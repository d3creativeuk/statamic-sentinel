{
    "name": "d3creative/statamic-sentinel",
    "description": "Sentinel by D3 Creative - Platform and dependency audits for Statamic sites. Sentinel surfaces PHP version, Statamic version, and known package vulnerabilities in the Control Panel.",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "D3 Creative",
            "homepage": "https://d3creative.uk/?utm_source=sentinel&utm_medium=packagist&utm_campaign=author"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0|^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "D3Creative\\Sentinel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D3Creative\\Sentinel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Sentinel",
            "description": "Monitor your Statamic version, PHP version, and package vulnerabilities directly from the Control Panel.",
            "developer": "D3 Creative",
            "developer_url": "https://d3creative.uk/?utm_source=sentinel&utm_medium=statamic-marketplace&utm_campaign=developer",
            "tags": ["monitoring", "security", "maintenance"]
        },
        "laravel": {
            "providers": [
                "D3Creative\\Sentinel\\ServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
